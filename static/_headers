/*
  Content-Security-Policy:
    script-src 'self'
      'unsafe-inline'
      'unsafe-eval';
  Cache-Control: public, max-age=0, must-revalidate

# 缓存策略 ------------------------------------------------------------------
# · HTML 走上面的兜底：每次回源校验，新文章立即可见；
# · 带内容指纹的 CSS/JS 可以永久缓存（文件名里的 hash 就是版本号）；
# · 字体与图片文件名固定，给中等周期，替换内容后不至于被缓存一年。
/css/main.min.*
  Cache-Control: public, max-age=31536000, immutable
/js/*.min.*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=604800
/img/*
  Cache-Control: public, max-age=2592000

# 分享卡片（OG / Twitter）单独放一个目录：只受 /* 兜底的
# max-age=0, must-revalidate 约束，不要套用上面 /img/* 的 30 天缓存，
# 否则 X / 微信 / QQ 的预览抓取器会一直拿到旧卡片。
# 文件名带版本号，换内容时递增 v3、v4… 强制平台重新抓取。
/share/*
  Cache-Control: public, max-age=0, must-revalidate
